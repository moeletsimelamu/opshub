root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,slnx,html,css,scss,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true

# Test names use the Method_Scenario_ExpectedResult convention.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core writes migrations; code analysis rules are for hand-written code.
[src/OpsHub.Api/Data/Migrations/*.cs]
generated_code = true
